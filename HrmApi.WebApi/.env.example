# =====================================================
# Seed Admin Configuration
# Dùng để tạo tài khoản admin mặc định khi khởi động lần đầu
# =====================================================
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin@123
SEED_ADMIN_EMAIL=admin@hrm.com

# =====================================================
# SMTP Configuration (override appsettings.json)
# Nếu set ở đây sẽ ghi đè SmtpSettings trong appsettings.json
# =====================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_ENABLE_SSL=true
# SMTP_FROM_EMAIL=no-reply@hrm.com
